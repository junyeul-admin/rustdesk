+// OAMap add-on 0001 test: runs the real oamapSoftKeyboardDiff
+// (lib/oamap/oamap_input.dart) on the 63 soft keyboard cases of
+// .github/oamap/sim_input.cjs: same IME steps in the same order, same expected
+// text, same remote field model (text + caret, VK_BACK deletes one code
+// point). The six numbers per case (VK_BACK, keys, strings, string chars, key
+// route, onChanged calls) are the node simulation's ADDON numbers, so the Dart
+// code and the node mirror must send exactly the same keys.
+//   cd flutter && flutter test test/oamap_input_test.dart
+// The case lines below (C(...)) are kept in the same shape as sim_input.cjs.
+
+import 'dart:math';
+
+import 'package:flutter_hbb/oamap/oamap_input.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// remote_page.dart: final initText = '1' * 1024;
+final String _init = '1' * 1024;
+
+bool _hi(int u) => (u & 0xFC00) == 0xD800;
+bool _lo(int u) => (u & 0xFC00) == 0xDC00;
+
+// Code units of the character (code point) just before index i.
+int _cpBefore(String s, int i) =>
+    (i >= 2 && _lo(s.codeUnitAt(i - 1)) && _hi(s.codeUnitAt(i - 2))) ? 2 : 1;
+
+String _dropLast(String s) =>
+    s.isEmpty ? s : s.substring(0, s.length - _cpBefore(s, s.length));
+
+// Remote PC text field: inputModel.inputKey / bind.sessionInputString.
+class _Remote {
+  _Remote(this.text) : caret = text.length;
+
+  String text;
+  int caret;
+  int back = 0;
+  int keys = 0;
+  int strings = 0;
+  int strChars = 0;
+
+  void _insert(String s) {
+    text = text.substring(0, caret) + s + text.substring(caret);
+    caret += s.length;
+  }
+
+  void inputKey(String name) {
+    keys++;
+    if (name == 'VK_BACK') {
+      back++;
+      if (caret > 0) {
+        final n = _cpBefore(text, caret);
+        text = text.substring(0, caret - n) + text.substring(caret);
+        caret -= n;
+      }
+    } else if (name == 'VK_RETURN') {
+      _insert('\n');
+    } else if (name == 'VK_SPACE') {
+      _insert(' ');
+    } else if (name == 'VK_LEFT') {
+      if (caret > 0) caret -= _cpBefore(text, caret);
+    } else if (name == 'VK_RIGHT') {
+      if (caret < text.length) caret += _hi(text.codeUnitAt(caret)) ? 2 : 1;
+    } else {
+      _insert(name);
+    }
+  }
+
+  void sessionInputString(String value) {
+    strings++;
+    strChars += value.length;
+    _insert(value);
+  }
+}
+
+// remote_page.dart: _value, inputChar, _handleNonIOSSoftKeyboardInput
+// (the OAMap 0001 branch, kOamapHangulInput = true).
+class _Page {
+  _Page(this.remote);
+
+  final _Remote remote;
+  String value = _init;
+
+  void inputChar(String char) {
+    var key = char;
+    if (key == '\n') {
+      key = 'VK_RETURN';
+    } else if (key == ' ') {
+      key = 'VK_SPACE';
+    }
+    remote.inputKey(key);
+  }
+
+  void handleNonIOSSoftKeyboardInput(String newValue) {
+    final oldValue = value;
+    value = newValue;
+    oamapSoftKeyboardDiff(oldValue, newValue,
+        back: () => remote.inputKey('VK_BACK'),
+        char: inputChar,
+        string: (s) => remote.sessionInputString(s));
+  }
+}
+
+// Phone keyboard (IME): the hidden field is '1' * sent + user, onChanged only
+// when the whole value changes. base + user = what the remote field should hold.
+class Ime {
+  Ime(String r0)
+      : base = r0,
+        remote = _Remote(r0) {
+    page = _Page(remote);
+    prev = _field();
+  }
+
+  final _Remote remote;
+  late final _Page page;
+  String base;
+  int sent = 1024;
+  String user = '';
+  int caret = 0;
+  int wordStart = 0;
+  int keyRoute = 0;
+  int changes = 0;
+  late String prev;
+
+  String _field() => ('1' * sent) + user;
+
+  void _emit() {
+    final f = _field();
+    if (f != prev) {
+      changes++;
+      page.handleNonIOSSoftKeyboardInput(f);
+      prev = _field();
+    }
+  }
+
+  // _openKeyboardUnlocked: new phone field, the remote field is unchanged.
+  void _resetField() {
+    base += user;
+    user = '';
+    caret = 0;
+    wordStart = 0;
+    sent = 1024;
+    page.value = _init;
+  }
+
+  // Composing word (wordStart..caret) becomes s.
+  void w(String s) {
+    user = user.substring(0, wordStart) + s + user.substring(caret);
+    caret = wordStart + s.length;
+    _emit();
+  }
+
+  // Some Gboard versions: empty the composing word first, then set it.
+  void w2(String s) {
+    user = user.substring(0, wordStart) + user.substring(caret);
+    caret = wordStart;
+    _emit();
+    w(s);
+  }
+
+  // Committed text at the caret (one onChanged).
+  void ins(String s) {
+    user = user.substring(0, caret) + s + user.substring(caret);
+    caret += s.length;
+    wordStart = caret;
+    _emit();
+  }
+
+  // One backspace (g = code units of a combined emoji).
+  void bs([int g = 0]) {
+    if (caret > 0) {
+      final n = g != 0 ? g : _cpBefore(user, caret);
+      user = user.substring(0, caret - n) + user.substring(caret);
+      caret -= n;
+      wordStart = min(wordStart, caret);
+      _emit();
+    } else if (sent > 0) {
+      sent--;
+      base = _dropLast(base);
+      _emit();
+    } else {
+      // empty field: no onChanged, VK_BACK goes by the key event route
+      keyRoute++;
+      remote.inputKey('VK_BACK');
+      base = _dropLast(base);
+    }
+  }
+
+  // n code units before the caret become s (autocorrect, prediction).
+  void repl(int n, String s) {
+    user = user.substring(0, caret - n) + s + user.substring(caret);
+    caret = caret - n + s.length;
+    wordStart = caret;
+    _emit();
+  }
+
+  // setSelection: caret only, no onChanged.
+  void caretTo(int i) {
+    caret = i;
+    wordStart = i;
+  }
+
+  // Arrow key events: the remote caret moves, the phone field does not.
+  void dpad(String dir, int n) {
+    for (var k = 0; k < n; k++) {
+      remote.inputKey(dir);
+    }
+  }
+
+  void selectAllPaste(String s) {
+    sent = 0;
+    user = s;
+    caret = s.length;
+    wordStart = caret;
+    _emit();
+  }
+
+  void reopen() {
+    _resetField();
+    prev = _field();
+  }
+
+  // Auto-paired punctuation: both come in, caret between them.
+  void pair(String p) {
+    user = user.substring(0, caret) + p + user.substring(caret);
+    caret += 1;
+    wordStart = caret;
+    _emit();
+  }
+
+  // Closing symbol typed over: caret moves one, text unchanged.
+  void overtype() {
+    caret += 1;
+    wordStart = caret;
+  }
+}
+
+class _Case {
+  _Case(this.group, this.name, this.ops, this.r0, this.want, this.known);
+
+  final String group;
+  final String name;
+  final void Function(Ime) ops;
+  final String? r0;
+  final String Function()? want;
+  // Known limitation: what the remote field really ends up with.
+  final String? known;
+}
+
+final List<_Case> _cases = [];
+
+// ignore: non_constant_identifier_names
+void C(String group, String name, void Function(Ime) ops,
+    {String? r0, String Function()? want, String? known}) {
+  _cases.add(_Case(group, name, ops, r0, want, known));
+}
+
+// ignore: non_constant_identifier_names
+void W(Ime A, List<String> list) {
+  for (final s in list) {
+    A.w(s);
+  }
+}
+
+// ignore: constant_identifier_names
+const String R0 = '메모:';
+// ignore: non_constant_identifier_names
+final String LONG = '가나다라마바사아자차카타파하' * 15 + '끝';
+
+void _defineCases() {
+  // @@CASES-BEGIN (same order as sim_input.cjs)
+  C('천지인', '이준열', (A) => W(A, ['ㅇ', '이', '잊', '이즈', '이주', '이준', '이준ㅇ', '이준ㅇᆞ', '이준ㅇᆢ', '이준여', '이준연', '이준열']));
+  C('천지인', '안녕하세요', (A) => W(A, ['ㅇ', '이', '아', '안', '안ㄴ', '안ㄴᆞ', '안ㄴᆢ', '안녀', '안녕', '안녕ㅅ', '안녕ㅎ', '안녕히', '안녕하', '안녕핫', '안녕하ㅅᆞ', '안녕하서', '안녕하세', '안녕하셍', '안녕하세ㅇᆞ', '안녕하세ㅇᆢ', '안녕하세요']));
+  C('천지인', '획 추가 이→아→야', (A) => W(A, ['ㅇ', '이', '아', '야']));
+  C('천지인', '으→우→유', (A) => W(A, ['ㅇ', '으', '우', '유']));
+  C('천지인', '아→애', (A) => W(A, ['ㅇ', '이', '아', '애']));
+  C('천지인', '된소리 ㄱ→ㅋ→ㄲ 받침', (A) => W(A, ['ㄱ', '기', '가', '각', '갘', '갂']));
+  C('천지인', '된소리 받침 넘김 가끼', (A) => W(A, ['ㄱ', '기', '가', '각', '갘', '갂', '가끼']));
+  C('천지인', '받침이 다음 글자로 이준→이주녀', (A) => W(A, ['ㅇ', '이', '잊', '이즈', '이주', '이준', '이준ᆞ', '이준ᆢ', '이주녀']));
+  C('천지인', 'ㄴㄹ 키 두 번 단→달', (A) => W(A, ['ㄷ', '디', '다', '단', '달']));
