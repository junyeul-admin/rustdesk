+  C('천지인', '띄어쓰기 안녕 하세요', (A) { W(A, ['ㅇ', '이', '아', '안', '안ㄴ', '안ㄴᆞ', '안ㄴᆢ', '안녀', '안녕']); A.ins(' '); W(A, ['ㅅ', 'ㅎ', '히', '하', '핫', '하ㅅᆞ', '하서', '하세', '하셍', '하세ㅇᆞ', '하세ㅇᆢ', '하세요']); });
+  C('천지인', '조합 중 지우기 인→이→ㅇ→아', (A) => W(A, ['ㅇ', '이', '인', '이', 'ㅇ', '이', '아']));
