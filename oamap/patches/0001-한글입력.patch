+  C('섞기', '한글+영문+숫자', (A) { W(A, ['ㄱ', '가']); A.ins('a'); A.ins('b'); A.ins('1'); A.ins('2'); W(A, ['ㄴ', '나']); });
+  C('섞기', '기호 가!?@#', (A) { W(A, ['ㄱ', '가']); ['!', '?', '@', '#'].forEach((c) => A.ins(c)); });
