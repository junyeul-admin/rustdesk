@@ -0,0 +1,29 @@
+// OAMap 0007: every add-on hook line is still in the upstream files.
+// A missing line means a patch was applied partly or upstream moved code.
+'use strict';
+const fs = require('fs');
+const need = [
+  ['0001', 'flutter/lib/mobile/pages/remote_page.dart', 'oamapSoftKeyboardDiff(oldValue, newValue,'],
+  ['0001', 'flutter/lib/mobile/pages/remote_page.dart', 'enableIMEPersonalizedLearning: !kOamapImeNoLearning,'],
+  ['0002', 'flutter/lib/mobile/pages/remote_page.dart', '...oamapImeKeys(wrap, inputModel, isMac),'],
+  ['0003', 'flutter/lib/mobile/pages/remote_page.dart', '_oamapKeeper.open();'],
+  ['0003', 'flutter/lib/mobile/pages/remote_page.dart', '_oamapKeeper.close();'],
+  ['0003', 'flutter/lib/mobile/pages/remote_page.dart', '_oamapKeeper.onLifecycle(state);'],
+  ['0003', 'flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/MainActivity.kt', '"client_session_fgs" ->'],
+  ['0003', 'flutter/android/app/src/main/AndroidManifest.xml', 'android:name=".ClientSessionService"'],
+  ['0004', 'flutter/lib/mobile/pages/remote_page.dart', 'resizeToAvoidBottomInset: oamapResizeToAvoidBottomInset,'],
+  ['0004', 'flutter/lib/mobile/pages/remote_page.dart', '_oamapKbCanvas'],
+  ['0005', 'flutter/lib/models/model.dart', 'var cx = oamapPanEdgeX(r, dx);'],
+  ['0005', 'flutter/lib/mobile/pages/remote_page.dart', 'oamapIsRealRotation(ctx, orientation)'],
+  ['0006', 'flutter/lib/main.dart', 'if (kOamapUpdateCheck) checkUpdate();'],
+  ['0006', 'flutter/android/app/build.gradle', 'project.findProperty("oamapAppId")'],
+  ['0006', 'flutter/android/app/src/main/AndroidManifest.xml', 'android:label="@string/oamap_app_label"'],
+];
+let bad = 0;
+for (const [no, file, text] of need) {
+  let s = '';
+  try { s = fs.readFileSync(file, 'utf8'); } catch (e) { /* missing file */ }
+  if (!s.includes(text)) { bad++; console.log(`MISSING ${no} ${file}: ${text}`); }
+}
+console.log(bad ? `OAMap hooks: ${bad} missing` : `OAMap hooks: all ${need.length} present`);
+process.exitCode = bad ? 1 : 0;
diff --git a/.github/oamap/make_android_workflow.cjs b/.github/oamap/make_android_workflow.cjs
new file mode 100644
index 0000000..611a587
--- /dev/null
+++ b/.github/oamap/make_android_workflow.cjs
@@ -0,0 +1,192 @@
+// OAMap add-on 0007: build .github/workflows/oamap-android.yml from the
+// upstream .github/workflows/flutter-build.yml of the same tag, so the pinned
+// tool versions (Flutter, NDK, vcpkg, actions) always match upstream.
+//   node .github/oamap/make_android_workflow.cjs [flutter-build.yml] [out.yml]
+// Keeps: env block, generate-bridge, build-rustdesk-android (aarch64 only).
+// Adds: server-default step (secrets), add-on checks, dart-define input.
+// Drops: release publishing (APK goes to the run's Artifacts only).
+// Adds: security-scan / security-apk-permissions jobs (non-blocking).
+'use strict';
+const fs = require('fs');
+const src = process.argv[2] || '.github/workflows/flutter-build.yml';
+const out = process.argv[3] || '.github/workflows/oamap-android.yml';
+const text = fs.readFileSync(src, 'utf8').replace(/\r\n/g, '\n');
+const lines = text.split('\n');
+const fail = (m) => { console.error('OAMap 0007: ' + m); process.exit(1); };
+
+function block(startRe, endRe) {
+  const s = lines.findIndex((l) => startRe.test(l));
+  if (s < 0) return null;
+  let e = s + 1;
+  while (e < lines.length && !endRe.test(lines[e])) e++;
+  return lines.slice(s, e);
+}
+const env = block(/^env:\s*$/, /^jobs:\s*$/);
+if (!env) fail('env block not found');
+const jobRe = /^  [A-Za-z0-9_-]+:\s*$/;
+const bridge = block(/^  generate-bridge:\s*$/, jobRe);
+const android = block(/^  build-rustdesk-android:\s*$/, jobRe);
+if (!bridge || !android) fail('job generate-bridge / build-rustdesk-android not found');
+
+const bridgeOut = bridge.filter((l) => !/^    needs:/.test(l));
+let a = android.join('\n');
+
+// matrix: aarch64 only
+a = a.replace(/(\n          - \{[\s\S]*?\n            \})/g, (m) => (/arch: aarch64\b/.test(m) ? m : ''));
+if (!/arch: aarch64/.test(a)) fail('aarch64 matrix entry not found');
+
+// after checkout: server defaults + add-on checks
+const checkout = /(\n      - name: Checkout source code\n(?:        .*\n)+?)(\n      - )/;
+if (!checkout.test(a)) fail('checkout step not found');
+a = a.replace(checkout, (m, step, next) => step +
+  '\n      - name: OAMap add-on checks (hooks + input simulation)\n' +
+  '        run: |\n' +
+  '          node .github/oamap/check_hooks.cjs\n' +
+  '          node .github/oamap/sim_input.cjs\n' +
+  '\n      - name: OAMap server defaults (GitHub secrets, values never printed)\n' +
+  '        env:\n' +
+  '          OAMAP_ID_SERVER: ${{ secrets.OAMAP_ID_SERVER }}\n' +
+  '          OAMAP_PUB_KEY: ${{ secrets.OAMAP_PUB_KEY }}\n' +
+  '        run: python3 .github/oamap/set_server_defaults.py libs/hbb_common/src/config.rs\n' + next);
+
+// dart-define flags through env (no ${{ }} inside the script)
+if (!/--split-per-abi/.test(a)) fail('flutter build apk line not found');
+a = a.replace(/--split-per-abi/g, '--split-per-abi $OAMAP_DART_DEFINES');
+a = a.replace(/(      - name: Build rustdesk\n        shell: bash\n        env:\n)/, '$1          OAMAP_DART_DEFINES: ${{ inputs.dart_defines }}\n');
+if (!/OAMAP_DART_DEFINES: \$\{\{ inputs.dart_defines \}\}/.test(a)) fail('Build rustdesk env not found');
+
+// no release publishing: drop "Publish ..." steps, upload to Artifacts only
+a = a.replace(/\n      - name: Publish[^\n]*\n(?:        [^\n]*\n|          [^\n]*\n)*/g, '\n');
+a = a.replace(/if: env\.ANDROID_SIGNING_KEY != null && env\.UPLOAD_ARTIFACT == 'true'/g, 'if: env.ANDROID_SIGNING_KEY != null');
+a = a.replace(/\s*$/, '\n') +
+  '\n      - name: Upload unsigned apk (test only, no signing key secret)\n' +
+  '        if: env.ANDROID_SIGNING_KEY == null\n' +
+  '        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n' +
+  '        with:\n' +
+  '          name: oamap-remote-unsigned-${{ env.VERSION }}-${{ matrix.job.arch }}.apk\n' +
+  '          path: signed-apk/*.apk\n';
+
+// security checks: separate jobs, the build never needs them, so a finding
+// cannot stop or change the apk; it marks the run red (GitHub mail) instead.
+// Logic in .github/oamap/security_check.cjs; baselines = same upstream tag.
+const raw = 'https://raw.githubusercontent.com/rustdesk/rustdesk/${VERSION}/';
+const security = [
+  '',
+  '  # OAMap 0007: security checks (separate jobs: never block the apk build)',
+  '  security-scan:',
+  '    name: OAMap security scan (deps, manifest, secrets)',
+  '    runs-on: ubuntu-24.04',
+  '    steps:',
+  '      - name: Checkout source code',
+  '        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4',
+  '',
+  '      - name: Upstream baseline files (same RustDesk tag)',
+  '        run: |',
+  '          mkdir -p security-report',
+  '          for f in Cargo.lock flutter/pubspec.lock flutter/android/app/src/main/AndroidManifest.xml; do',
+  '            mkdir -p "base/$(dirname "$f")"',
+  '            curl -fsSL --retry 3 -o "base/$f" "' + raw + '$f"',
+  '          done',
+  '',
+  '      - name: Permissions and exported components vs upstream manifest',
+  '        if: ${{ !cancelled() }}',
+  '        run: node .github/oamap/security_check.cjs manifest flutter/android/app/src/main/AndroidManifest.xml base/flutter/android/app/src/main/AndroidManifest.xml',
+  '',
+  '      - name: Secrets never printed (workflow scripts)',
+  '        if: ${{ !cancelled() }}',
+  '        run: node .github/oamap/security_check.cjs secrets .github/workflows/oamap-android.yml .github/oamap/set_server_defaults.py',
+  '',
+  '      - name: Rust crates - cargo audit (RustSec), new vs upstream',
+  '        if: ${{ !cancelled() }}',
+  '        run: |',
+  '          cargo install cargo-audit --locked --quiet',
+  '          cargo audit --json --file Cargo.lock > security-report/cargo-audit-ours.json || true',
+  '          cargo audit --json --no-fetch --file base/Cargo.lock > security-report/cargo-audit-upstream.json || true',
+  '          node .github/oamap/security_check.cjs audit security-report/cargo-audit-ours.json security-report/cargo-audit-upstream.json',
+  '',
+  '      - name: Dart and Rust packages - OSV-Scanner, new vs upstream',
+  '        if: ${{ !cancelled() }}',
+  '        run: |',
+  '          u=https://github.com/google/osv-scanner/releases/latest/download',
+  '          curl -fsSL --retry 3 -o osv-scanner_linux_amd64 "$u/osv-scanner_linux_amd64"',
+  '          curl -fsSL --retry 3 -o osv-sums "$u/osv-scanner_SHA256SUMS"',
+  "          grep ' osv-scanner_linux_amd64$' osv-sums | sha256sum -c -",
+  '          chmod +x osv-scanner_linux_amd64',
+  '          ./osv-scanner_linux_amd64 --format json --lockfile flutter/pubspec.lock --lockfile Cargo.lock > security-report/osv-ours.json || true',
+  '          ./osv-scanner_linux_amd64 --format json --lockfile base/flutter/pubspec.lock --lockfile base/Cargo.lock > security-report/osv-upstream.json || true',
+  '          node .github/oamap/security_check.cjs osv security-report/osv-ours.json security-report/osv-upstream.json',
+  '',
+  '      - name: Newer RustDesk release (the app update check is off)',
+  '        if: ${{ !cancelled() }}',
+  '        env:',
+  '          GH_TOKEN: ${{ github.token }}',
+  '        run: |',
+  '          latest=$(gh api repos/rustdesk/rustdesk/releases/latest --jq .tag_name || echo unknown)',
+  '          node .github/oamap/security_check.cjs upstream "$latest"',
+  '',
+  '      - name: Upload security report',
+  '        if: ${{ !cancelled() }}',
+  '        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1',
+  '        with:',
+  '          name: oamap-security-report-scan',
+  '          path: security-report/',
+  '',
+  '  security-apk-permissions:',
+  '    name: OAMap security - apk permissions vs official apk',
+  '    needs: [build-rustdesk-android]',
+  '    runs-on: ubuntu-24.04',
+  '    steps:',
+  '      - name: Checkout source code',
+  '        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4',
+  '',
+  '      - name: Our apk (this run)',
+  '        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1',
+  '        with:',
+  '          pattern: "*.apk"',
+  '          path: ours-apk',
+  '',
+  '      - name: Compare uses-permission with the official apk',
+  '        run: |',
+  '          mkdir -p security-report',
+  '          sdk="${ANDROID_HOME:-/usr/local/lib/android/sdk}"',
+  '          aapt2="$sdk/build-tools/$(ls "$sdk/build-tools" | sort -V | tail -n 1)/aapt2"',
+  "          ours=$(find ours-apk -name '*.apk' -type f | head -n 1)",
+  '          if [ -z "$ours" ]; then echo "::error::no apk artifact in this run"; exit 1; fi',
+  '          "$aapt2" dump permissions "$ours" > security-report/apk-permissions-ours.txt',
+  '          if curl -fsSL --retry 3 -o official.apk "https://github.com/rustdesk/rustdesk/releases/download/${VERSION}/rustdesk-${VERSION}-aarch64.apk"; then',
+  '            "$aapt2" dump permissions official.apk > security-report/apk-permissions-official.txt',
+  '            node .github/oamap/security_check.cjs apkperms security-report/apk-permissions-ours.txt security-report/apk-permissions-official.txt',
+  '          else',
+  '            curl -fsSL --retry 3 -o upstream-manifest.xml "' + raw + 'flutter/android/app/src/main/AndroidManifest.xml"',
+  '            node .github/oamap/security_check.cjs apkperms security-report/apk-permissions-ours.txt upstream-manifest.xml --source',
+  '          fi',
+  '',
+  '      - name: Upload security report',
+  '        if: ${{ !cancelled() }}',
+  '        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1',
+  '        with:',
+  '          name: oamap-security-report-apk',
+  '          path: security-report/',
+  '',
+];
+
+const head = [
+  '# OAMap: generated by .github/oamap/make_android_workflow.cjs from',
+  '# flutter-build.yml - do not edit by hand, re-run the generator instead.',
+  'name: OAMap android apk (aarch64)',
+  '',
+  'on:',
+  '  workflow_dispatch:',
+  '    inputs:',
+  '      dart_defines:',
+  '        description: "Extra flags, e.g. --dart-define=OAMAP_NO_SHAKE=false"',
+  '        type: string',
+  '        default: ""',
+  '',
+  'permissions:',
+  '  contents: read',
+  '',
+];
+const body = head.concat(env, ['jobs:'], bridgeOut, [a], security).join('\n').replace(/\n{3,}/g, '\n\n');
+fs.writeFileSync(out, body);
+console.log('OAMap 0007: wrote ' + out + ' (' + body.split('\n').length + ' lines)');
diff --git a/.github/oamap/security_check.cjs b/.github/oamap/security_check.cjs
new file mode 100644
index 0000000..525c4e7
--- /dev/null
+++ b/.github/oamap/security_check.cjs
@@ -0,0 +1,320 @@
+// OAMap 0007: security checks for the android build (run by the jobs
+// security-scan / security-apk-permissions in oamap-android.yml).
+// Every check compares OUR tree with the SAME upstream RustDesk tag, so only
+// what our add-ons change can turn a check red; what upstream already has is
+// listed as the baseline ("기준 목록") and never fails the job.
+//
+//   node security_check.cjs manifest <ours.xml> <upstream.xml>
+//   node security_check.cjs secrets  <workflow.yml> [script.py ...]
+//   node security_check.cjs audit    <cargo-audit-ours.json> <cargo-audit-upstream.json>
+//   node security_check.cjs osv      <osv-ours.json> <osv-upstream.json>
+//   node security_check.cjs apkperms <aapt2-ours.txt> <aapt2-official.txt | upstream.xml --source>
+//   node security_check.cjs upstream <latest-release-tag>        (warning only)
+//
+// Output: markdown to $GITHUB_STEP_SUMMARY and security-report/<check>.md,
+// ::error:: / ::warning:: annotations, exit code 1 when a check fails.
+// The build job does not depend on these jobs: a red check never stops or
+// changes the apk, it only marks the run as failed (GitHub sends a mail).
+'use strict';
+const fs = require('fs');
+const path = require('path');
+
+const [cmd, ...args] = process.argv.slice(2);
+const out = [];
+let failed = false;
+const md = (s) => out.push(s);
+const err = (s) => { failed = true; console.log('::error title=OAMap security::' + s); };
+const warn = (s) => console.log('::warning title=OAMap security::' + s);
+const read = (f) => { try { return fs.readFileSync(f, 'utf8'); } catch (e) { return null; } };
+const esc = (s) => String(s == null ? '' : s).replace(/\|/g, '/').replace(/\r?\n/g, ' ');
+
+function finish(name) {
+  md('');
+  md(failed ? '**결과: 실패 (위 빨간 줄 확인)**' : '**결과: 통과**');
+  md('');
+  const text = out.join('\n') + '\n';
+  if (process.env.GITHUB_STEP_SUMMARY) fs.appendFileSync(process.env.GITHUB_STEP_SUMMARY, text);
+  fs.mkdirSync('security-report', { recursive: true });
+  fs.writeFileSync(path.join('security-report', name + '.md'), text);
+  console.log(text);
+  process.exitCode = failed ? 1 : 0;
+}
+
+// ------------------------------------------------------------ CVSS 3.x score
+function cvss3(vector) {
+  if (!/^CVSS:3\.[01]\//.test(vector || '')) return null;
+  const m = {};
+  for (const p of vector.split('/').slice(1)) { const [k, v] = p.split(':'); m[k] = v; }
+  const changed = m.S === 'C';
+  const AV = { N: 0.85, A: 0.62, L: 0.55, P: 0.2 }[m.AV];
+  const AC = { L: 0.77, H: 0.44 }[m.AC];
+  const PR = { N: 0.85, L: changed ? 0.68 : 0.62, H: changed ? 0.5 : 0.27 }[m.PR];
+  const UI = { N: 0.85, R: 0.62 }[m.UI];
+  const cia = (x) => ({ H: 0.56, L: 0.22, N: 0 }[x]);
+  const C = cia(m.C), I = cia(m.I), A = cia(m.A);
+  if ([AV, AC, PR, UI, C, I, A].some((x) => x === undefined)) return null;
+  const iss = 1 - (1 - C) * (1 - I) * (1 - A);
+  const impact = changed ? 7.52 * (iss - 0.029) - 3.25 * Math.pow(iss - 0.02, 15) : 6.42 * iss;
+  if (impact <= 0) return 0;
+  const expl = 8.22 * AV * AC * PR * UI;
+  const raw = changed ? Math.min(1.08 * (impact + expl), 10) : Math.min(impact + expl, 10);
+  return Math.ceil(raw * 10 - 1e-9) / 10;
+}
+// High = CVSS >= 7, or no usable score (unknown counts as high: be careful).
+const isHigh = (score) => score == null || score >= 7;
+const scoreText = (score) => (score == null ? '점수 없음(높음으로 봄)' : String(score));
+
+// ------------------------------------------------------------ manifest
+function manifestInfo(xml) {
+  const perms = new Set();
+  const removed = new Set();
+  for (const m of xml.matchAll(/<uses-permission(?:-sdk-23)?\b[^>]*>/g)) {
+    const name = (m[0].match(/android:name="([^"]+)"/) || [])[1];
+    if (!name) continue;
+    if (/tools:node="remove"/.test(m[0])) removed.add(name); else perms.add(name);
+  }
+  const exported = new Set();
+  const fgsTypes = new Map();
+  for (const m of xml.matchAll(/<(activity|activity-alias|service|receiver|provider)\b[^>]*>/g)) {
+    const name = (m[0].match(/android:name="([^"]+)"/) || [])[1] || '?';
+    if (/android:exported="true"/.test(m[0])) exported.add(m[1] + ' ' + name);
+    const t = (m[0].match(/android:foregroundServiceType="([^"]+)"/) || [])[1];
+    if (t) fgsTypes.set(name, t.split('|'));
+  }
+  return { perms, removed, exported, fgsTypes };
+}
+const FGS_PERM = {
+  camera: 'CAMERA', connectedDevice: 'CONNECTED_DEVICE', dataSync: 'DATA_SYNC', health: 'HEALTH',
+  location: 'LOCATION', mediaPlayback: 'MEDIA_PLAYBACK', mediaProjection: 'MEDIA_PROJECTION',
+  microphone: 'MICROPHONE', phoneCall: 'PHONE_CALL', remoteMessaging: 'REMOTE_MESSAGING',
+  shortService: null, specialUse: 'SPECIAL_USE', systemExempted: 'SYSTEM_EXEMPTED',
+  mediaProcessing: 'MEDIA_PROCESSING',
+};
+
+function cmdManifest(oursFile, baseFile) {
+  md('## OAMap 보안: 권한·내보낸 부품 (원본 매니페스트 비교)');
+  const ours = read(oursFile), base = read(baseFile);
+  if (!ours || !base) { err('manifest file missing: ' + (!ours ? oursFile : baseFile)); return finish('manifest'); }
+  const o = manifestInfo(ours), b = manifestInfo(base);
+  const added = [...o.perms].filter((p) => !b.perms.has(p));
+  const dropped = [...b.perms].filter((p) => !o.perms.has(p));
+  md(`- 권한: 우리 ${o.perms.size} · 상류 ${b.perms.size} · **늘어난 것 ${added.length}** · 줄어든 것 ${dropped.length}`);
+  if (added.length) {
+    md('\n| 늘어난 권한 |\n|---|');
+    for (const p of added) { md(`| ${p} |`); err('permission added by our patches: ' + p); }
+  }
+  const newExp = [...o.exported].filter((x) => !b.exported.has(x));
+  md(`- 밖에서 부를 수 있는(exported=true) 부품: 우리 ${o.exported.size} · 상류 ${b.exported.size} · **새로 생긴 것 ${newExp.length}**`);
+  for (const x of newExp) { md(`  - ${x}`); err('new exported component: ' + x); }
+  // Every foreground service type must have its FOREGROUND_SERVICE_<TYPE>
+  // permission, otherwise startForeground() throws on Android 14+.
+  md('\n| 앞쪽 서비스 | 종류 | 필요한 권한 | 선언됨 | 상류에도 있던 권한 |\n|---|---|---|---|---|');
+  for (const [svc, types] of o.fgsTypes) {
+    for (const t of types) {
+      const need = FGS_PERM[t] === undefined ? '?' : FGS_PERM[t];
+      const perm = need ? 'android.permission.FOREGROUND_SERVICE_' + need : '(없음)';
+      const ok = !need || o.perms.has(perm);
+      md(`| ${svc} | ${t} | ${perm} | ${ok ? '예' : '아니오'} | ${!need || b.perms.has(perm) ? '예' : '아니오'} |`);
+      if (!ok) err(`${svc} uses foregroundServiceType=${t} but ${perm} is not declared`);
+    }
+  }
+  if (!o.perms.has('android.permission.FOREGROUND_SERVICE') && o.fgsTypes.size) err('FOREGROUND_SERVICE not declared');
+  finish('manifest');
+}
+
+// ------------------------------------------------------------ secrets in workflow scripts
+function runBlocks(yml) {
+  const lines = yml.replace(/\r\n/g, '\n').split('\n');
+  const blocks = [];
+  for (let i = 0; i < lines.length; i++) {
+    const m = lines[i].match(/^(\s*)(?:- )?run:\s?(.*)$/);
+    if (!m) continue;
+    const ind = m[1].length;
+    const body = [{ n: i + 1, t: m[2] }];
+    for (let j = i + 1; j < lines.length; j++) {
+      const l = lines[j];
